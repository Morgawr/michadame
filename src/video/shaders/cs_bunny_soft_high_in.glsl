#version 430
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba8) uniform readonly image2D input_tex;
layout(binding = 1, rgba8) uniform writeonly image2D output_tex;

uniform vec2 input_size;

shared float G[1][10][10];

void main() {
	ivec2 xy = ivec2(gl_LocalInvocationID.xy);
	ivec2 pos = ivec2(gl_WorkGroupID.xy) * ivec2(8, 8) + xy;
	ivec2 opos = pos * ivec2(3, 1);
	ivec2 sz = ivec2(input_size) - ivec2(1);

	for (int y = 0; y < 10; y += 8) {
		int ay = xy.y + y;
		if (ay >= 10) break;
		for (int x = 0; x < 10; x += 8) {
			int ax = xy.x + x;
			if (ax >= 10) break;
			vec3 c = imageLoad(input_tex, clamp(pos + ivec2(x - 1, y - 1), ivec2(0), sz)).rgb;
			G[0][ay][ax] = dot(c, vec3(0.299, 0.587, 0.114));
		}
	}
	barrier();

	float s0_0_0, s0_0_1, s0_0_2, s0_1_0, s0_1_1, s0_1_2, s0_2_0, s0_2_1, s0_2_2;
	vec4 r0, r1, r2;
	r0 = vec4(0.0); r1 = vec4(0.0); r2 = vec4(0.0);
	s0_0_0 = G[0][xy.y+0][xy.x+0]; s0_0_1 = G[0][xy.y+0][xy.x+1];
	s0_0_2 = G[0][xy.y+0][xy.x+2]; s0_1_0 = G[0][xy.y+1][xy.x+0];
	s0_1_1 = G[0][xy.y+1][xy.x+1]; s0_1_2 = G[0][xy.y+1][xy.x+2];
	s0_2_0 = G[0][xy.y+2][xy.x+0]; s0_2_1 = G[0][xy.y+2][xy.x+1];
	s0_2_2 = G[0][xy.y+2][xy.x+2];

	r0 += vec4(2.322e-02, -1.334e-02, -3.813e-01, 7.910e-03) * s0_0_0;
	r1 += vec4(5.275e-01, 4.515e-03, -1.155e-02, -1.005e-02) * s0_0_0;
	r2 += vec4(6.457e-03, -2.327e-01, 1.199e-02, 8.356e-03) * s0_0_0;
	r0 += vec4(-2.629e-02, 9.310e-03, 2.420e-01, 2.029e-02) * s0_0_1;
	r1 += vec4(-5.410e-01, -2.006e-02, -2.862e-02, 1.862e-02) * s0_0_1;
	r2 += vec4(9.178e-01, 4.564e-01, 9.718e-01, 5.527e-01) * s0_0_1;
	r0 += vec4(-5.596e-03, -2.557e-03, 9.555e-02, -3.055e-02) * s0_0_2;
	r1 += vec4(3.034e-02, 4.269e-03, 6.556e-02, -3.897e-02) * s0_0_2;
	r2 += vec4(-9.238e-01, -1.487e-02, 2.676e-02, -1.692e-02) * s0_0_2;
	r0 += vec4(-2.434e-02, -8.784e-01, 1.569e-01, -2.853e-02) * s0_1_0;
	r1 += vec4(-5.235e-01, -3.186e-02, 2.751e-02, -1.664e-02) * s0_1_0;
	r2 += vec4(-1.066e-02, -8.471e-02, -1.319e-02, -2.474e-03) * s0_1_0;
	r0 += vec4(5.137e-01, 8.809e-01, -2.154e-01, 6.148e-01) * s0_1_1;
	r1 += vec4(2.204e-01, -9.160e-01, -1.003e+00, -1.794e-01) * s0_1_1;
	r2 += vec4(4.694e-02, -2.050e-02, -9.473e-01, -5.840e-01) * s0_1_1;
	r0 += vec4(-7.205e-03, 2.723e-03, 6.471e-02, -2.853e-01) * s0_1_2;
	r1 += vec4(2.836e-01, -2.596e-02, 4.541e-01, -3.645e-02) * s0_1_2;
	r2 += vec4(-3.672e-02, -5.897e-02, -4.198e-02, -5.657e-02) * s0_1_2;
	r0 += vec4(-3.135e-02, -9.858e-03, 1.565e-01, 4.558e-03) * s0_2_0;
	r1 += vec4(1.898e-02, 2.736e-02, 4.620e-03, 2.843e-02) * s0_2_0;
	r2 += vec4(4.234e-03, -4.465e-03, 2.688e-03, 4.187e-02) * s0_2_0;
	r0 += vec4(-4.582e-01, 9.960e-03, -1.802e-01, -1.242e-01) * s0_2_1;
	r1 += vec4(3.098e-01, 9.331e-01, 1.831e-01, 5.111e-01) * s0_2_1;
	r2 += vec4(-1.963e-03, 5.862e-02, -2.674e-02, -2.304e-02) * s0_2_1;
	r0 += vec4(-6.111e-02, -5.471e-05, 1.940e-02, -7.496e-02) * s0_2_2;
	r1 += vec4(-3.271e-01, 2.240e-02, 1.412e-01, -3.351e-01) * s0_2_2;
	r2 += vec4(-3.684e-03, -4.067e-02, 1.415e-02, -1.691e-02) * s0_2_2;

	r0 += vec4(-2.169e-03, -2.010e-07, -2.248e-02, 8.771e-03);
	imageStore(output_tex, opos + ivec2(0, 0), clamp(r0, 0.0, 1.0));
	r1 += vec4(-5.858e-03, -4.679e-06, -1.530e-02, -3.276e-03);
	imageStore(output_tex, opos + ivec2(1, 0), clamp(r1, 0.0, 1.0));
	r2 += vec4(-1.539e-04, -7.213e-03, -1.678e-04, -1.016e-03);
	imageStore(output_tex, opos + ivec2(2, 0), clamp(r2, 0.0, 1.0));
}
