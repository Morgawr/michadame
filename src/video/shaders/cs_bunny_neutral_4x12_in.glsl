#version 430
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba8) uniform readonly image2D input_tex;
layout(binding = 1, rgba8) uniform writeonly image2D output_tex;

uniform vec2 input_size;

shared float G[1][10][10];

void main() {
	ivec2 xy = ivec2(gl_LocalInvocationID.xy);
	ivec2 pos = ivec2(gl_WorkGroupID.xy) * ivec2(8, 8) + xy;
	ivec2 opos = pos * ivec2(3, 1);
	ivec2 sz = ivec2(input_size) - ivec2(1);

	for (int y = 0; y < 10; y += 8) {
		int ay = xy.y + y;
		if (ay >= 10) break;
		for (int x = 0; x < 10; x += 8) {
			int ax = xy.x + x;
			if (ax >= 10) break;
			vec3 c = imageLoad(input_tex, clamp(pos + ivec2(x - 1, y - 1), ivec2(0), sz)).rgb;
			G[0][ay][ax] = dot(c, vec3(0.299, 0.587, 0.114));
		}
	}
	barrier();

	float s0_0_0, s0_0_1, s0_0_2, s0_1_0, s0_1_1, s0_1_2, s0_2_0, s0_2_1, s0_2_2;
	vec4 r0, r1, r2;
	r0 = vec4(0.0); r1 = vec4(0.0); r2 = vec4(0.0);
	s0_0_0 = G[0][xy.y+0][xy.x+0]; s0_0_1 = G[0][xy.y+0][xy.x+1];
	s0_0_2 = G[0][xy.y+0][xy.x+2]; s0_1_0 = G[0][xy.y+1][xy.x+0];
	s0_1_1 = G[0][xy.y+1][xy.x+1]; s0_1_2 = G[0][xy.y+1][xy.x+2];
	s0_2_0 = G[0][xy.y+2][xy.x+0]; s0_2_1 = G[0][xy.y+2][xy.x+1];
	s0_2_2 = G[0][xy.y+2][xy.x+2];
	r0 += vec4(-1.180e-02, 2.921e-02, -1.708e-02, -3.549e-02) * s0_0_0;
	r1 += vec4(-3.333e-02, 3.755e-02, -7.966e-03, 4.193e-01) * s0_0_0;
	r2 += vec4(-9.901e-03, 5.099e-03, 1.276e-02, 1.781e-01) * s0_0_0;
	r0 += vec4(-6.404e-02, 3.232e-01, -6.895e-01, 2.656e-01) * s0_0_1;
	r1 += vec4(2.812e-01, 8.849e-01, -1.357e-02, 9.602e-02) * s0_0_1;
	r2 += vec4(-3.796e-02, -3.514e-02, -1.620e-02, -3.232e-01) * s0_0_1;
	r0 += vec4(5.030e-02, -3.564e-01, -6.252e-03, -4.889e-03) * s0_0_2;
	r1 += vec4(-6.496e-02, 1.997e-02, 2.193e-02, -9.322e-02) * s0_0_2;
	r2 += vec4(4.069e-02, 6.738e-01, -6.296e-03, -1.228e-01) * s0_0_2;
	r0 += vec4(-2.886e-02, 1.117e-03, 1.275e-02, 2.686e-01) * s0_1_0;
	r1 += vec4(3.849e-02, -2.660e-02, 2.349e-02, 1.013e-01) * s0_1_0;
	r2 += vec4(1.430e-02, 9.772e-03, 2.062e-03, 1.087e-02) * s0_1_0;
	r0 += vec4(-6.032e-01, -6.045e-01, 6.971e-01, -4.214e+00) * s0_1_1;
	r1 += vec4(2.097e-01, -9.004e-01, -6.009e-01, -3.998e-01) * s0_1_1;
	r2 += vec4(-7.998e-01, 6.749e-03, 7.207e-01, -2.234e-01) * s0_1_1;
	r0 += vec4(-1.467e-02, 6.074e-01, 1.234e-03, 2.822e-01) * s0_1_2;
	r1 += vec4(2.541e-01, -1.975e-02, -1.701e-02, -1.334e-01) * s0_1_2;
	r2 += vec4(8.105e-01, -6.858e-01, -7.025e-01, -4.971e-02) * s0_1_2;
	r0 += vec4(3.923e-02, -2.393e-02, 2.260e-03, -2.054e-02) * s0_2_0;
	r1 += vec4(-1.334e-02, -2.263e-02, 5.768e-01, -6.918e-02) * s0_2_0;
	r2 += vec4(-8.656e-03, -9.668e-03, -1.791e-02, -1.674e-01) * s0_2_0;
	r0 += vec4(6.660e-01, -2.099e-02, -3.813e-03, 2.486e-01) * s0_2_1;
	r1 += vec4(2.046e-02, 3.414e-02, 2.150e-02, -1.246e-01) * s0_2_1;
	r2 += vec4(-8.330e-03, 8.864e-03, 3.935e-02, 5.159e-01) * s0_2_1;
	r0 += vec4(-3.362e-02, 4.429e-02, 5.309e-03, -1.706e-02) * s0_2_2;
	r1 += vec4(-2.161e-02, -5.611e-03, -5.108e-03, 2.026e-01) * s0_2_2;
	r2 += vec4(-8.218e-04, 2.162e-02, -2.705e-02, 1.801e-01) * s0_2_2;
	r0 += vec4(1.971e-02, 1.283e-03, -2.700e-04, 2.812e-02);
	r0 = max(r0, vec4(0.0));
	r1 += vec4(-2.571e-01, 1.251e-02, 7.403e-05, -2.179e-03);
	r1 = max(r1, vec4(0.0));
	r2 += vec4(1.095e-02, 2.144e-04, 1.733e-02, -4.165e-03);
	r2 = max(r2, vec4(0.0));

	imageStore(output_tex, opos + ivec2(0, 0), clamp(r0, 0.0, 1.0));
	imageStore(output_tex, opos + ivec2(1, 0), clamp(r1, 0.0, 1.0));
	imageStore(output_tex, opos + ivec2(2, 0), clamp(r2, 0.0, 1.0));
}