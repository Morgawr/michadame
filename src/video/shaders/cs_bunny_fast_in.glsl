#version 430
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba8) uniform readonly image2D input_tex;
layout(binding = 1, rgba8) uniform writeonly image2D output_tex;

uniform vec2 input_size;

shared float G[1][10][10];

void main() {
	ivec2 xy = ivec2(gl_LocalInvocationID.xy);
	ivec2 pos = ivec2(gl_WorkGroupID.xy) * ivec2(8, 8) + xy;
	ivec2 opos = pos * ivec2(3, 1);
	ivec2 sz = ivec2(input_size) - ivec2(1);
	
	for (int y = 0; y < 10; y += 8) {
		int ay = xy.y + y;
		if (ay >= 10) break;
		for (int x = 0; x < 10; x += 8) {
			int ax = xy.x + x;
			if (ax >= 10) break;
			vec3 c = imageLoad(input_tex, clamp(pos + ivec2(x - 1, y - 1), ivec2(0), sz)).rgb;
			G[0][ay][ax] = dot(c, vec3(0.299, 0.587, 0.114));
		}
	}
	barrier();
	
	float s0_0_0, s0_0_1, s0_0_2, s0_1_0, s0_1_1, s0_1_2, s0_2_0, s0_2_1, s0_2_2;
	vec4 r0, r1, r2;
	r0 = vec4(0.0); r1 = vec4(0.0); r2 = vec4(0.0);
	s0_0_0 = G[0][xy.y+0][xy.x+0]; s0_0_1 = G[0][xy.y+0][xy.x+1];
	s0_0_2 = G[0][xy.y+0][xy.x+2]; s0_1_0 = G[0][xy.y+1][xy.x+0];
	s0_1_1 = G[0][xy.y+1][xy.x+1]; s0_1_2 = G[0][xy.y+1][xy.x+2];
	s0_2_0 = G[0][xy.y+2][xy.x+0]; s0_2_1 = G[0][xy.y+2][xy.x+1];
	s0_2_2 = G[0][xy.y+2][xy.x+2];
	
	r0 += vec4(3.974e-03, -4.994e-02, -1.106e-01, 7.984e-02) * s0_0_0;
	r1 += vec4(-1.146e-02, 2.714e-02, -1.208e-01, -5.811e-03) * s0_0_0;
	r2 += vec4(2.306e-02, -1.984e-02, -1.205e-02, -5.797e-03) * s0_0_0;
	r0 += vec4(8.621e-01, 4.326e-01, 5.918e-01, -1.650e-01) * s0_0_1;
	r1 += vec4(5.566e-03, -1.528e-01, 1.548e-01, -3.752e-01) * s0_0_1;
	r2 += vec4(-2.113e-02, -2.094e-04, 6.522e-02, -5.227e-02) * s0_0_1;
	r0 += vec4(1.085e-02, -1.058e-01, -7.681e-03, -8.618e-02) * s0_0_2;
	r1 += vec4(2.526e-03, -1.193e-01, 1.655e-01, 2.262e-02) * s0_0_2;
	r2 += vec4(4.877e-03, 8.765e-03, 9.976e-03, 3.630e-02) * s0_0_2;
	r0 += vec4(-6.514e-03, -1.627e-02, 9.897e-02, 3.289e-02) * s0_1_0;
	r1 += vec4(7.988e-01, 3.223e-02, 3.274e-02, -2.993e-01) * s0_1_0;
	r2 += vec4(2.822e-03, -4.395e-03, 3.037e-01, -2.012e-01) * s0_1_0;
	r0 += vec4(-8.652e-01, -1.159e-02, 8.169e-02, 4.252e-01) * s0_1_1;
	r1 += vec4(-7.781e-01, 4.338e-01, 2.879e-01, 7.549e-01) * s0_1_1;
	r2 += vec4(6.310e-01, -1.011e-01, -2.446e-01, 5.293e-01) * s0_1_1;
	r0 += vec4(-5.410e-03, -9.159e-02, -6.371e-01, -6.387e-01) * s0_1_2;
	r1 += vec4(-1.319e-02, -1.619e-01, 2.345e-01, -8.862e-02) * s0_1_2;
	r2 += vec4(-1.833e-02, 3.118e-02, 2.168e-02, -4.513e-02) * s0_1_2;
	r0 += vec4(5.906e-05, -6.218e-03, 2.289e-02, -1.228e-01) * s0_2_0;
	r1 += vec4(-1.375e-02, 1.999e-02, 9.690e-02, 1.443e-02) * s0_2_0;
	r2 += vec4(2.581e-02, -1.284e-01, 3.156e-02, -6.670e-02) * s0_2_0;
	r0 += vec4(2.334e-03, -4.197e-03, -1.160e-01, 3.487e-01) * s0_2_1;
	r1 += vec4(2.869e-03, -2.522e-02, -4.490e-01, 8.423e-02) * s0_2_1;
	r2 += vec4(-5.647e-03, 3.777e-01, -1.097e-01, -1.901e-01) * s0_2_1;
	r0 += vec4(-4.110e-03, 1.439e-03, 7.400e-02, 1.250e-01) * s0_2_2;
	r1 += vec4(6.177e-03, 1.872e-02, -4.033e-01, -1.047e-01) * s0_2_2;
	r2 += vec4(1.412e-02, 1.066e-02, -2.194e-02, 2.292e-02) * s0_2_2;
	r0 += vec4(-7.280e-05, 1.400e-04, -1.296e-04, 4.014e-04);
	r0 = clamp(r0, 0.0, 1.0);
	imageStore(output_tex, opos + ivec2(0, 0), clamp(r0, 0.0, 1.0));
	r1 += vec4(-1.023e-03, 2.540e-04, 1.793e-03, -4.770e-03);
	r1 = clamp(r1, 0.0, 1.0);
	imageStore(output_tex, opos + ivec2(1, 0), clamp(r1, 0.0, 1.0));
	r2 += vec4(-5.813e-04, 2.326e-02, 2.179e-02, 3.161e-03);
	r2 = clamp(r2, 0.0, 1.0);
	imageStore(output_tex, opos + ivec2(2, 0), clamp(r2, 0.0, 1.0));
}
